# /etc/ebook/tutor.env (права 600, владелец root) — настройки сервиса /api/tutor
TUTOR_HOST=127.0.0.1
TUTOR_PORT=8000
LLM_URL=http://127.0.0.1:8080
LLM_TIMEOUT=300
# EMBED_URL=http://127.0.0.1:8081        # смысловой поиск (llama-embed.service); без него — поиск по словам

# Карты кейсов: только опубликованные. Пока нет CMS — выгрузка из src/data.js (server/tools/export_cases.mjs)
CARDS_SOURCE=file:/opt/ebook-ai/server/data/cases.json
# CARDS_SOURCE=directus:https://cms.ebook.vku.edu.kz   (+ DIRECTUS_TOKEN=…)
CARDS_REFRESH=300

# Вход. Пилот на прототипе: demo (+ закрыть сайт на nginx: auth_basic или список IP).
# Рабочая версия: oidc (Keycloak) — нужен пакет python3-jwt (PyJWT с cryptography).
AUTH_MODE=demo
# OIDC_ISSUER=https://ebook.vku.edu.kz/auth/realms/ebook
# OIDC_JWKS_URL=https://ebook.vku.edu.kz/auth/realms/ebook/protocol/openid-connect/certs
# OIDC_AUDIENCE=ebook
# PSEUDONYM_SALT=<случайная строка 32+ символа, не менять после запуска: от неё зависят псевдонимы>

# Нагрузка: SLOTS = -np у llama-server
SLOTS=4
QUEUE=8
QUEUE_WAIT=90
RATE_PER_MIN=6
RATE_PER_DAY=200

# Данные: диалоги пишутся только при согласии пользователя и STORE_DIALOGS=1
DB_PATH=/srv/data/ebook-ai/db/tutor.db
STORE_DIALOGS=0
DIALOG_RETENTION_DAYS=180

# Прогрев кэша префикса: языки и число кейсов (не больше числа слотов)
WARMUP=kz
WARMUP_MAX=4
