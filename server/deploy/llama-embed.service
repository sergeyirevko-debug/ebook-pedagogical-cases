# /etc/systemd/system/llama-embed.service — НЕОБЯЗАТЕЛЬНО: векторы для смыслового поиска по каталогу
# (multilingual-e5-small в GGUF, ~120 МБ RAM). Без него поиск работает по словам. В tutor.env: EMBED_URL=http://127.0.0.1:8081
[Unit]
Description=llama.cpp embeddings: multilingual-e5-small (поиск по каталогу e-book)
After=network.target

[Service]
User=ebook-ai
Group=ebook-ai
ExecStart=/opt/llama.cpp/build/bin/llama-server \
  -m /srv/data/ebook-ai/models/multilingual-e5-small-Q8_0.gguf \
  --embeddings --pooling mean -ngl 0 -t 2 -c 512 -b 512 -ub 512 \
  --host 127.0.0.1 --port 8081 --no-webui
Restart=on-failure
NoNewPrivileges=yes
ProtectSystem=strict
ProtectHome=yes
PrivateTmp=yes

[Install]
WantedBy=multi-user.target
